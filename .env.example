PORT=8080

DB_USER=searchly
DB_PASSWORD=searchly
DB_NAME=searchly
DB_PORT=5432
DATABASE_URL=postgres://searchly:searchly@localhost:5432/searchly?sslmode=disable

LOG_LEVEL=info
LOG_FORMAT=json

PROVIDER1_URL=https://raw.githubusercontent.com/WEG-Technology/mock/refs/heads/main/v2/provider1
PROVIDER2_URL=https://raw.githubusercontent.com/WEG-Technology/mock/refs/heads/main/v2/provider2

# Per provider. 0 disables the rate limit, the timeout and retries respectively.
PROVIDER_RATE_LIMIT=2
PROVIDER_TIMEOUT=5s
PROVIDER_MAX_RETRIES=3

# How often the ingest worker runs (e.g. 5m). 0 or empty runs once.
INGEST_INTERVAL=5m
# Longest a provider's run may take. In a worker it is also the lease after
# which another worker may take the provider over.
INGEST_RUN_TIMEOUT=2m
# How often a worker looks for providers that are due.
INGEST_POLL_INTERVAL=10s
